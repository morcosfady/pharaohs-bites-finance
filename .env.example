# Copy to .env.local (never commit .env.local).
# Both values come from Supabase → Project Settings → API.
# The anon key is safe in the browser ONLY because Row Level Security is
# enabled on every table (see supabase/migrations). Never put the
# service_role key here or anywhere in this repository.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: shown in the UI and used for "message customer" links.
VITE_BUSINESS_WHATSAPP=17879684078
